{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example-med.org/schemas/histology-lecture-v1.schema.json",
  "title": "Histology and Pathology WSI Lecture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "viewer", "sections"],
  "properties": {
    "schema_version": { "const": 1 },
    "metadata": { "$ref": "#/$defs/metadata" },
    "viewer": { "$ref": "#/$defs/viewer" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    },
    "overlays": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/overlayGroup" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "subject", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "subject": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "author": { "type": "string" },
        "level": { "type": "string" },
        "estimated_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "viewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dzi_url", "coordinate_space", "image_width", "image_height"],
      "properties": {
        "dzi_url": { "type": "string", "format": "uri", "pattern": "^https?://.*\\.dzi(?:\\?.*)?$" },
        "label": { "type": "string" },
        "coordinate_space": { "const": "image-pixels" },
        "image_width": { "type": "number", "exclusiveMinimum": 0 },
        "image_height": { "type": "number", "exclusiveMinimum": 0 },
        "show_navigator": { "type": "boolean", "default": true },
        "max_zoom_pixel_ratio": { "type": "number", "minimum": 1, "maximum": 16, "default": 4 }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "blocks"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/paragraph" }
        }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nodes"],
      "properties": {
        "type": { "const": "paragraph" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/textNode" },
              { "$ref": "#/$defs/strongNode" },
              { "$ref": "#/$defs/waypointNode" }
            ]
          }
        }
      }
    },
    "textNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "strongNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "strong" },
        "text": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "waypointNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "text", "x", "y", "zoom_level"],
      "properties": {
        "type": { "const": "waypoint" },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "x": { "type": "number", "minimum": 0, "description": "Horizontal source-image pixel coordinate." },
        "y": { "type": "number", "minimum": 0, "description": "Vertical source-image pixel coordinate." },
        "zoom_level": { "type": "number", "exclusiveMinimum": 0, "description": "Image zoom; 1.0 displays one source pixel per CSS pixel." }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 }
      }
    },
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "x", "y", "width", "height"],
      "properties": {
        "type": { "const": "rectangle" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "points"],
      "properties": {
        "type": { "const": "polygon" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "overlayGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "color", "shapes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "visible_by_default": { "type": "boolean", "default": true },
        "shapes": {
          "type": "array",
          "minItems": 1,
          "items": { "oneOf": [{ "$ref": "#/$defs/rectangle" }, { "$ref": "#/$defs/polygon" }] }
        }
      }
    }
  }
}
