{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://important-9qf.pages.dev/histology-template/histology-lecture.schema.json",
  "title": "Histology lecture",
  "description": "Legacy single-slide (v1) and semantic multi-slide (v2) histology lectures.",
  "oneOf": [
    { "$ref": "#/$defs/legacyLecture" },
    { "$ref": "#/$defs/semanticLecture" }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "subject", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "$ref": "#/$defs/text" },
        "subject": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "author": { "type": "string" },
        "course": { "type": "string" },
        "level": { "type": "string" },
        "estimated_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "viewerOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show_navigator": { "type": "boolean" },
        "navigator_position": { "enum": ["TOP_LEFT", "TOP_RIGHT", "BOTTOM_LEFT", "BOTTOM_RIGHT"] },
        "min_zoom_level": { "type": "number", "exclusiveMinimum": 0 },
        "max_zoom_level": { "type": "number", "exclusiveMinimum": 0 },
        "default_zoom_level": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "legacyViewer": {
      "type": "object",
      "required": ["dzi_url"],
      "properties": {
        "dzi_url": { "$ref": "#/$defs/text" },
        "image_width": { "type": "number", "exclusiveMinimum": 0 },
        "image_height": { "type": "number", "exclusiveMinimum": 0 },
        "show_navigator": { "type": "boolean" },
        "navigator_position": { "type": "string" },
        "min_zoom_level": { "type": "number", "exclusiveMinimum": 0 },
        "max_zoom_level": { "type": "number", "exclusiveMinimum": 0 },
        "default_zoom_level": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["organ", "stain", "diagnosis", "species"],
      "properties": {
        "organ": { "$ref": "#/$defs/text" },
        "stain": { "$ref": "#/$defs/text" },
        "diagnosis": { "$ref": "#/$defs/text" },
        "species": { "$ref": "#/$defs/text" },
        "structures": { "type": "array", "items": { "$ref": "#/$defs/text" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "url"],
          "properties": {
            "type": { "const": "dzi" }, "url": { "$ref": "#/$defs/text" },
            "source_label": { "type": "string" }, "attribution": { "type": "string" }, "license": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "info_url"],
          "properties": {
            "type": { "const": "iiif" }, "info_url": { "$ref": "#/$defs/text" },
            "source_label": { "type": "string" }, "attribution": { "type": "string" }, "license": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "url"],
          "properties": {
            "type": { "const": "image" }, "url": { "type": "string", "pattern": "^(https?://|data:image/)" },
            "source_label": { "type": "string" }, "attribution": { "type": "string" }, "license": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "crop": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      ],
      "minItems": 4, "maxItems": 4
    },
    "fallback": {
      "oneOf": [
        {
          "type": "object", "required": ["fileType", "page"],
          "properties": { "fileType": { "const": "pdf" }, "page": { "type": "integer", "minimum": 1 }, "crop": { "$ref": "#/$defs/crop" } },
          "additionalProperties": false
        },
        {
          "type": "object", "required": ["fileType", "slide"],
          "properties": {
            "fileType": { "const": "pptx" }, "slide": { "type": "integer", "minimum": 1 },
            "image": { "type": "integer", "minimum": 1 }, "media": { "$ref": "#/$defs/text" }, "crop": { "$ref": "#/$defs/crop" }
          },
          "additionalProperties": false
        },
        {
          "type": "object", "required": ["fileType"],
          "anyOf": [{ "required": ["image"] }, { "required": ["media"] }],
          "properties": {
            "fileType": { "const": "docx" }, "image": { "type": "integer", "minimum": 1 },
            "media": { "$ref": "#/$defs/text" }, "crop": { "$ref": "#/$defs/crop" }
          },
          "additionalProperties": false
        }
      ]
    },
    "shape": {
      "oneOf": [
        {
          "type": "object", "required": ["type", "label", "x", "y", "width", "height"],
          "properties": {
                "type": { "const": "rectangle" }, "label": { "$ref": "#/$defs/text" }, "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 },
            "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object", "required": ["type", "label", "points"],
          "properties": {
            "type": { "const": "polygon" }, "label": { "$ref": "#/$defs/text" },
            "points": {
              "type": "array", "minItems": 3,
              "items": {
                "type": "object", "required": ["x", "y"],
                "properties": { "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 } },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "overlay": {
      "type": "object", "required": ["id", "label", "color", "shapes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "label": { "$ref": "#/$defs/text" },
        "color": { "type": "string" }, "visible_by_default": { "type": "boolean" },
        "shapes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shape" } }
      },
      "additionalProperties": false
    },
    "slide": {
      "type": "object", "required": ["id", "label"],
      "anyOf": [{ "required": ["source"] }, { "required": ["fallback"] }],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "label": { "$ref": "#/$defs/text" },
        "description": { "type": "string" }, "alt": { "type": "string" }, "request": { "$ref": "#/$defs/request" },
        "source": { "$ref": "#/$defs/source" }, "fallback": { "$ref": "#/$defs/fallback" },
        "resolution": { "enum": ["verified-catalog", "lecture-image-fallback"] }, "catalog_match": { "type": "string" },
        "image_width": { "type": "number", "exclusiveMinimum": 0 }, "image_height": { "type": "number", "exclusiveMinimum": 0 },
        "overlays": { "type": "array", "items": { "$ref": "#/$defs/overlay" } }
      },
      "additionalProperties": false
    },
    "textNode": {
      "type": "object", "required": ["type", "text"],
      "properties": { "type": { "enum": ["text", "strong"] }, "text": { "$ref": "#/$defs/text" } }, "additionalProperties": false
    },
    "slideNode": {
      "type": "object", "required": ["type", "text", "slide_id"],
      "properties": { "type": { "const": "slide" }, "text": { "$ref": "#/$defs/text" }, "slide_id": { "type": "string" } }, "additionalProperties": false
    },
    "waypointNode": {
      "type": "object", "required": ["type", "id", "text", "x", "y", "zoom_level"],
      "properties": {
        "type": { "const": "waypoint" }, "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "text": { "$ref": "#/$defs/text" }, "slide_id": { "type": "string" },
        "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 }, "zoom_level": { "type": "number", "exclusiveMinimum": 0 },
        "overlay_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "legacyParagraph": {
      "type": "object", "required": ["nodes"],
      "properties": { "type": {}, "nodes": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/$defs/textNode" }, { "$ref": "#/$defs/waypointNode" }] } } },
      "additionalProperties": false
    },
    "semanticParagraph": {
      "type": "object", "required": ["nodes"],
      "properties": { "type": {}, "nodes": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/$defs/textNode" }, { "$ref": "#/$defs/slideNode" }, { "$ref": "#/$defs/waypointNode" }] } } },
      "additionalProperties": false
    },
    "legacySection": {
      "type": "object", "required": ["id", "title", "blocks"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "title": { "$ref": "#/$defs/text" },
        "blocks": { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/legacyParagraph" }, { "properties": { "type": { "const": "paragraph" } }, "required": ["type"] }] } }
      },
      "additionalProperties": false
    },
    "semanticSection": {
      "type": "object", "required": ["id", "title", "blocks"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "title": { "$ref": "#/$defs/text" },
        "blocks": { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/semanticParagraph" }, { "properties": { "type": { "const": "paragraph" } }, "required": ["type"] }] } }
      },
      "additionalProperties": false
    },
    "legacyLecture": {
      "type": "object", "required": ["schema_version", "metadata", "viewer", "sections"],
      "properties": {
        "schema_version": { "const": 1 }, "metadata": { "$ref": "#/$defs/metadata" }, "viewer": { "$ref": "#/$defs/legacyViewer" },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/legacySection" } },
        "overlays": { "type": "array", "items": { "$ref": "#/$defs/overlay" } }
      },
      "additionalProperties": false
    },
    "semanticLecture": {
      "type": "object", "required": ["schema_version", "metadata", "slides", "sections"],
      "properties": {
        "schema_version": { "const": 2 }, "metadata": { "$ref": "#/$defs/metadata" }, "viewer_options": { "$ref": "#/$defs/viewerOptions" },
        "slides": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slide" } },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/semanticSection" } }
      },
      "additionalProperties": false
    }
  }
}
